---
// Logo: ASCII art `pockio` (figlet font „standard", 6 řádků × 31 sloupců, jen běžné ASCII)
// + podtitul „✻ Pocket-sized helpers · pockio.eu". Na Domů obyčejný <h1>, na výpisech odkaz na Domů.
interface Props {
  href?: string | undefined;
  tagline?: string | undefined;
  term?: boolean; // odkaz navigace bez načítání
}
const { href, tagline, term = false } = Astro.props;
const ART = [
  '                  _    _       ',
  ' _ __   ___   ___| | _(_) ___  ',
  "| '_ \\ / _ \\ / __| |/ / |/ _ \\ ",
  '| |_) | (_) | (__|   <| | (_) |',
  '| .__/ \\___/ \\___|_|\\_\\_|\\___/ ',
  '|_|                            ',
].join('\n');
const Tag = href ? 'a' : 'div';
---
<Tag class="logo" href={href} data-term={href && term ? '' : undefined} aria-label={href ? 'pockio' : undefined}>
  {href
    ? <pre class="ascii" aria-hidden="true">{ART}</pre>
    : <h1 aria-label="pockio"><pre class="ascii" aria-hidden="true">{ART}</pre></h1>}
  {tagline && <span class="sub"><b>✻</b> {tagline} · pockio.eu</span>}
</Tag>

<style>
  .logo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: flex-start;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
  }
  h1 {
    margin: 0;
    font: inherit;
    font-weight: 400;
  }
  .ascii {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--al);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    white-space: pre;
    color: var(--acc);
  }
  .sub {
    font-family: var(--mono);
    font-size: var(--t3);
    line-height: 1.3;
    color: var(--mut);
    margin-top: 8px;
  }
  .sub b {
    color: var(--acc);
    font-weight: 400;
  }
</style>
