---
// Logo: okrová dlaždice s „p" + nápis `pockio` v Doto (živý text, ne obrázek).
// size: lg = Domů v rámečku, md = výpisy, sm = privacy.
interface Props {
  size?: 'lg' | 'md' | 'sm';
  href?: string | undefined;
  tagline?: string | undefined;
  framed?: boolean;
  term?: boolean; // odkaz navigace bez načítání
}
const { size = 'md', href, tagline, framed = true, term = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag
  class={`logo logo--${size}${framed ? ' logo--framed' : ''}`}
  href={href}
  data-term={href && term ? '' : undefined}
  aria-label={href ? 'Pockio' : undefined}
>
  <svg class="mark" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <rect x="6" y="6" width="88" height="88" rx="24" fill="#D9A441" />
    <g fill="none" stroke="#131313" stroke-width="8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M36 30 V72" />
      <circle cx="52" cy="46" r="16" />
    </g>
    <circle cx="52" cy="46" r="4" fill="#131313" />
  </svg>
  <span class="text">
    <span class="word">pockio</span>
    {tagline && <span class="sub"><b>✻</b> {tagline}</span>}
  </span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  .logo--framed {
    border: 1px solid var(--acc);
  }
  .mark {
    flex: none;
    display: block;
    filter: drop-shadow(0 0 10px var(--glow));
  }
  .text {
    display: flex;
    flex-direction: column;
  }
  .word {
    font-family: var(--dot);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--fg);
    text-shadow: 0 0 18px var(--glow);
  }
  .sub {
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.3;
    color: var(--mut);
    margin-top: 8px;
  }
  .sub b {
    color: var(--acc);
    font-weight: 400;
  }

  .logo--lg {
    gap: 20px;
    padding: 24px 28px 24px 24px;
    border-radius: 12px;
  }
  .logo--lg .mark { width: 76px; height: 76px; }
  .logo--lg .word { font-size: 56px; }

  .logo--md {
    gap: 18px;
    padding: 18px 26px 18px 20px;
    border-radius: 12px;
  }
  .logo--md .mark { width: 64px; height: 64px; }
  .logo--md .word { font-size: 46px; }

  .logo--sm {
    gap: 12px;
    padding: 10px 18px 10px 14px;
    border-radius: 10px;
    box-shadow: 0 0 16px rgba(217, 164, 65, 0.25);
  }
  .logo--sm .mark { width: 40px; height: 40px; }
  .logo--sm .word { font-size: 24px; }
  .logo--sm .sub { margin-top: 3px; font-size: 12px; }
  .logo--sm .sub b { display: none; }

  @media (max-width: 640px) {
    .logo--lg .word { font-size: 40px; }
    .logo--lg .mark { width: 60px; height: 60px; }
    .logo--md .word { font-size: 34px; }
    .logo--md .mark { width: 52px; height: 52px; }
  }
</style>
