---
// Zmenšený rámeček telefonu se screenshotem a popiskem (216×440 px × měřítko).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; caption: string }
const { src, caption } = Astro.props;
---
<figure class="shot">
  <div class="phone">
    <Image src={src} alt={caption} width={432} height={880} widths={[216, 432]} sizes="108px" loading="lazy" />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .shot { margin: 0; width: 108px; }
  .phone {
    width: 100%;
    aspect-ratio: 216 / 440;
    border: 1px solid var(--acc);
    border-radius: 14px;
    overflow: hidden;
    background: var(--term);
    box-shadow: 0 0 14px rgba(217, 164, 65, 0.3);
  }
  .phone :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  figcaption { margin-top: 8px; font-size: 12px; line-height: 1.4; color: var(--mut); }
  @media (max-width: 640px) {
    .shot { width: 100%; }
    .phone { border-radius: 18px; }
    figcaption { font-size: 13px; }
  }
</style>
