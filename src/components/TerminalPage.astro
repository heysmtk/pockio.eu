---
// Stránka jako výpis příkazu: logo, echo `> /příkaz`, výpis, `← /home`.
import Base from '../layouts/Base.astro';
import TerminalShell from './TerminalShell.astro';
import Logo from './Logo.astro';
import { homeUrl, t, type Lang } from '../i18n/ui';
import type { Alternates, PageKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  command: string; // např. "/about"
  title: string;
  description?: string | undefined;
  alternates: Alternates;
  current?: PageKey | undefined;
  wide?: boolean;
}
const { lang, command, title, description, alternates, current, wide = false } = Astro.props;
const ui = t(lang);
const home = homeUrl(lang);
---
<Base lang={lang} title={title} description={description} alternates={alternates} current={current}>
  <TerminalShell lang={lang} variant="page" windowTitle={`pockio — ${command}`}>
    <Logo size="md" href={home} tagline={ui.tagline} term />
    <p class="echo"><b>&gt;</b> <em>{command}</em></p>
    <div class={`out${wide ? ' wide' : ''}`} data-stream>
      <slot />
    </div>
    <p class="back"><a href={home} data-term>{ui.back}</a></p>
  </TerminalShell>
</Base>

<style>
  .echo { margin: 0; color: var(--mut); font-family: var(--mono); }
  .echo b { color: var(--acc); font-weight: 400; }
  .echo em { color: var(--fg); font-style: normal; }
  .back { margin: 0; font-family: var(--mono); }
  .back a { color: var(--acc-text); text-decoration: underline; text-underline-offset: 3px; }
  .back a:hover { color: var(--fg); }
</style>
