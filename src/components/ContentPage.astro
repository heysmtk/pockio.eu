---
// Stránka webu z Markdownu (kolekce `pages`): src/content/pages/<klíč>.<jazyk>.md
import { getEntry, render } from 'astro:content';
import TerminalPage from './TerminalPage.astro';
import { alternatesFor, type PageKey } from '../i18n/routes';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; page: Exclude<PageKey, 'home' | 'apps'> }
const { lang, page } = Astro.props;
const entry = await getEntry('pages', `${page}.${lang}`);
if (!entry) throw new Error(`Chybí src/content/pages/${page}.${lang}.md`);
const { Content } = await render(entry);
---
<TerminalPage
  lang={lang}
  command={entry.data.command}
  title={entry.data.title}
  description={entry.data.description}
  alternates={alternatesFor(page)}
  current={page}
>
  <Content />
</TerminalPage>
