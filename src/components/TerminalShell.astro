---
// Okno terminálu (760 px). Obsah (slot) je „obrazovka", která se při příkazu vymění.
// Vstupní řádek a nápověda zůstávají; skript `terminal.ts` je zapne (bez JS jsou skryté).
import '../styles/terminal-output.css';
import { commandsForScript } from '../data/commands';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  variant: 'home' | 'page';
  windowTitle: string;
}
const { lang, variant, windowTitle } = Astro.props;
const ui = t(lang);
const data = {
  lang,
  home: lang === 'en' ? '/' : '/cs/',
  ui: {
    notFound: ui.notFound,
    back: ui.back,
    helpTitle: ui.helpTitle,
    helpTip: ui.helpTip,
    tagline: ui.tagline,
  },
  commands: await commandsForScript(lang),
};
// `<` escapujeme, aby text v JSONu nikdy neukončil <script>
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<main class="stage" data-variant={variant}>
  <div class="container">
    <div class="term" id="term">
      <div class="bar">
        <i></i><i></i><i></i>
        <span id="term-title">{windowTitle}</span>
      </div>
      <div class="body">
        <div class="screen" id="term-screen" data-screen>
          <slot />
        </div>
        <div class="prompt" data-prompt hidden>
          <form class="in" action="#" autocomplete="off">
            <span class="p" aria-hidden="true">&gt;</span>
            <span class="field">
              <input
                id="term-input"
                type="text"
                spellcheck="false"
                autocomplete="off"
                autocapitalize="off"
                aria-label={ui.inputLabel}
                placeholder={ui.inputPlaceholder}
              />
              <span class="cursor" aria-hidden="true"></span>
            </span>
          </form>
          <p class="hint"><span>{ui.hintHelp}</span><span>{ui.hintTab}</span></p>
        </div>
      </div>
    </div>
  </div>
  <script id="pockio-data" type="application/json" set:html={json} />
</main>

<script>
  import '../scripts/terminal.ts';
</script>

<style>
  .stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-block: 56px 56px;
  }
  .stage[data-variant='home'] {
    justify-content: center;
    padding-block: 32px;
  }
  .stage > .container { width: min(var(--container), 100% - 2 * var(--gutter)); }

  .term {
    background: var(--term);
    border: 1px solid var(--line);
    border-radius: var(--r-term);
    overflow: hidden;
    font-family: var(--mono);
    color: var(--fg);
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    background: var(--bar);
  }
  .bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line);
    margin-right: 8px;
    display: inline-block;
  }
  .bar span {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: var(--mut);
    white-space: nowrap;
  }
  .body {
    padding: 28px 36px 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-size: 13.5px;
    line-height: 1.7;
  }
  .screen {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .prompt { display: flex; flex-direction: column; gap: 18px; margin-top: 4px; }
  .prompt[hidden] { display: none; }
  .in {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    margin: 0;
  }
  .in:focus-within { border-color: var(--dashed); }
  .p { color: var(--acc); }
  .field { position: relative; flex: 1; display: flex; align-items: center; }
  input {
    flex: 1;
    width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    caret-color: var(--acc);
    caret-shape: block;
  }
  input:focus-visible { outline: none; } /* rámeček .in:focus-within ukazuje fokus */
  input::placeholder { color: var(--mut); opacity: 1; }
  input:placeholder-shown { padding-left: calc(9px + 12px); caret-color: transparent; }
  .cursor {
    position: absolute;
    left: 0;
    top: 50%;
    width: 9px;
    height: 19px;
    margin-top: -9.5px;
    background: var(--acc);
    animation: blink 1.1s steps(1) infinite;
    display: none;
  }
  input:placeholder-shown + .cursor { display: block; }
  @keyframes blink { 50% { opacity: 0; } }
  .hint {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    font-size: 13px;
    color: var(--mut);
  }

  /* dotyková zařízení: jen klikatelný seznam, bez vstupu a bez klávesnice */
  @media (max-width: 640px), (pointer: coarse) {
    .prompt { display: none !important; }
  }
  @media (max-width: 640px) {
    .body { padding: 20px 18px; }
    .bar span { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
  }
</style>
