---
// Seznam příkazů (Domů, /apps). Každý řádek je obyčejný odkaz.
// `run` = příkaz vypíše výsledek v terminálu (skript), bez JS je to obyčejný odkaz na `href`.
export interface Item {
  name: string;
  description: string;
  href: string;
  run?: boolean;
}
interface Props {
  items: Item[];
  label: string;
  /** tlumený neklikatelný řádek pod seznamem */
  footer?: string | undefined;
}
const { items, label, footer } = Astro.props;
---
<div class="select">
  <p class="label">{label}</p>
  <ul class="cmds" data-cmd-list>
    {items.map((item, i) => (
      <li>
        <a
          class={`cmd${i === 0 ? ' is-selected' : ''}`}
          href={item.href}
          data-term={item.run ? undefined : ''}
          data-run={item.run ? item.name : undefined}
          data-cmd={item.name}
        >
          <span class="mark" aria-hidden="true">▸</span>
          <span class="n">/{item.name}</span>
          <span class="d">{item.description}</span>
        </a>
      </li>
    ))}
  </ul>
  {footer && <p class="soon"><span class="pad" aria-hidden="true"></span><span>{footer}</span></p>}
</div>

<style>
  .label { margin: 0 0 8px; color: var(--mut); }
  .cmds { list-style: none; margin: 0; padding: 0; gap: 0; }
  .cmds li { padding: 0; }
  .cmds li::before { content: none; }
  .cmd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 24px;
    padding: 6px 14px;
    border-radius: 6px;
    color: var(--fg);
    text-decoration: none;
  }
  .mark { visibility: hidden; width: 1.3ch; margin-right: -18px; color: var(--acc-text); }
  .n { width: 132px; font-weight: 500; }
  .d { color: var(--mut); }
  .cmd:hover, .cmd.is-selected { background: var(--tint); }
  .cmd:hover .n, .cmd.is-selected .n { color: var(--acc-text); font-weight: 700; }
  .cmd.is-selected .mark { visibility: visible; }
  .soon { margin: 0; padding: 6px 14px 0; color: var(--dim); display: flex; }
  .pad { display: inline-block; width: 17px; }
  @media (max-width: 640px) {
    .cmd { display: grid; grid-template-columns: 1.3ch 1fr; column-gap: 18px; row-gap: 0; }
    .mark { margin-right: 0; }
    .n { width: auto; }
    .d { grid-column: 2; }
  }
</style>
