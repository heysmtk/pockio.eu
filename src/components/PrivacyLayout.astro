---
// Privacy: samostatná textová stránka bez terminálu (kompaktní logo, Nunito, max 720 px vlevo).
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import { homeUrl, t, type Lang } from '../i18n/ui';
import type { Alternates } from '../i18n/routes';

interface Props {
  lang: Lang;
  title: string;
  alternates: Alternates;
  description?: string | undefined;
}
const { lang, title, alternates, description } = Astro.props;
const ui = t(lang);
const shortTagline = ui.tagline.split(' · ')[0];
---
<Base lang={lang} title={title} description={description} alternates={alternates} current="privacy">
  <header class="container top">
    <Logo size="sm" href={homeUrl(lang)} tagline={shortTagline} />
  </header>
  <main class="container">
    <article class="doc">
      <slot />
    </article>
  </main>
</Base>

<style>
  .top { padding: 20px var(--inset) 0; }
  main { padding: 0 var(--inset) 72px; }
  .doc {
    max-width: 720px;
    font-family: var(--sans);
    color: var(--mut);
    font-size: 16px;
    line-height: 1.75;
  }
  .doc :global(h1) {
    margin: 56px 0 8px;
    font-size: 44px;
    line-height: 1.15;
    font-weight: 800;
    color: var(--fg);
  }
  .doc :global(h2) {
    margin: 36px 0 8px;
    font-size: 21px;
    line-height: 1.3;
    font-weight: 800;
    color: var(--fg);
  }
  .doc :global(p) { margin: 0 0 12px; }
  .doc :global(.meta) { font-size: 14px; color: var(--mut); margin: 0 0 8px; }
  .doc :global(a) { color: var(--acc-text); }
  @media (max-width: 640px) {
    .doc :global(h1) { font-size: 34px; margin-top: 40px; }
  }
</style>
