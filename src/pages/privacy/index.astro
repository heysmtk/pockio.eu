---
import TerminalPage from '../../components/TerminalPage.astro';
import { alternatesFor } from '../../i18n/routes';
// DOČASNÝ zástupný text; ve fázi 3 z .md, před spuštěním zkontrolovat
---
<TerminalPage lang="en" command="/privacy" title="Privacy policy" alternates={alternatesFor('privacy')} current="privacy">
  <h2>Privacy policy</h2>
  <p class="dim">Last updated: [DATE]</p>
  <h3>The short version</h3>
  <p>The Pockio website does not use cookies, trackers or analytics. It does not ask you for any personal data.</p>
  <h3>What the server sees</h3>
  <p>The site is hosted as static files. Like any web server, the hosting provider may keep technical logs (for example your IP address and the time of the request) for security and operation. I do not have access to them in any way that identifies you, and I do not use them.</p>
  <h3>Email</h3>
  <p>If you write to me, I get your email address and your message. I use them only to reply, and I do not share them with anyone.</p>
  <h3>Apps</h3>
  <p>Each app has its own privacy policy, linked from its page. This page covers only the website.</p>
  <h3>Changes</h3>
  <p>If this policy changes, the new version appears here with a new date.</p>
</TerminalPage>
