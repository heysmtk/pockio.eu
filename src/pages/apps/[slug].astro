---
import AppPage from '../../components/AppPage.astro';
import { getReleasedApps } from '../../data/apps';

export async function getStaticPaths() {
  return (await getReleasedApps('en')).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<AppPage lang="en" entry={entry} />
