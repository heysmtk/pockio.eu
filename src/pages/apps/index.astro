---
import TerminalPage from '../../components/TerminalPage.astro';
import CommandList from '../../components/CommandList.astro';
import { getApps } from '../../data/commands';
import { alternatesFor } from '../../i18n/routes';
import { t } from '../../i18n/ui';

const lang = 'en';
const ui = t(lang);
const items = (await getApps(lang)).map((a) => ({ name: a.slug, description: a.title, href: a.href, icon: a.icon }));
---
<TerminalPage lang={lang} command="/apps" title="Apps" alternates={alternatesFor('apps')} current="apps">
  <CommandList label={ui.selectApp} items={items} footer={ui.moreSoon} />
</TerminalPage>
