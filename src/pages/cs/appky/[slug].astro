---
import AppPage from '../../../components/AppPage.astro';
import { getReleasedApps } from '../../../data/apps';

export async function getStaticPaths() {
  return (await getReleasedApps('cs')).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<AppPage lang="cs" entry={entry} />
