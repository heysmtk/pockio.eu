---
import TerminalPage from '../../components/TerminalPage.astro';
import { alternatesFor } from '../../i18n/routes';
// DOČASNÝ zástupný text; e-mail a odkaz na Google Play doplnit před spuštěním
---
<TerminalPage lang="cs" command="/kontakt" title="Kontakt" alternates={alternatesFor('contact')} current="contact">
  <h2>Napiš mi</h2>
  <p>Nápad na appku, chyba, otázka nebo jen pozdrav. Odpovídám, jak mi to večery dovolí.</p>
  <dl class="kv">
    <dt>E-mail</dt><dd><a href="mailto:hello@pockio.eu">[TVŮJ E-MAIL]</a></dd>
    <dt>Google Play</dt><dd><a href="https://play.google.com/">[ODKAZ NA VÝVOJÁŘSKÝ ÚČET]</a></dd>
  </dl>
  <p class="mut">Hlásíš chybu? Napiš název appky, verzi a model telefonu.</p>
</TerminalPage>
