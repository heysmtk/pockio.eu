---
import AppPrivacyPage from '../../../components/AppPrivacyPage.astro';
import { getReleasedApps } from '../../../data/apps';

export async function getStaticPaths() {
  return (await getReleasedApps('cs')).map((entry) => ({ params: { slug: entry.data.slug } }));
}
const { slug } = Astro.params;
---
<AppPrivacyPage lang="cs" slug={slug!} />
