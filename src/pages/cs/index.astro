---
import Base from '../../layouts/Base.astro';
import TerminalShell from '../../components/TerminalShell.astro';
import Logo from '../../components/Logo.astro';
import CommandList from '../../components/CommandList.astro';
import { getHomeCommands } from '../../data/commands';
import { alternatesFor } from '../../i18n/routes';
import { t } from '../../i18n/ui';

const lang = 'cs';
---
<Base lang={lang} alternates={alternatesFor('home')} current="home">
  <TerminalShell lang={lang} variant="home" windowTitle="pockio — zsh">
    <Logo size="lg" tagline={t(lang).tagline} />
    <CommandList label={t(lang).selectCommand} items={getHomeCommands(lang).map((c) => ({ name: c.name, description: c.description, href: c.type === 'link' ? c.href : '' }))} />
  </TerminalShell>
</Base>
