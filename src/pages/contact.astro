---
import TerminalPage from '../components/TerminalPage.astro';
import { alternatesFor } from '../i18n/routes';
// DOČASNÝ zástupný text; e-mail a odkaz na Google Play doplnit před spuštěním
---
<TerminalPage lang="en" command="/contact" title="Contact" alternates={alternatesFor('contact')} current="contact">
  <h2>Get in touch</h2>
  <p>An app idea, a bug, a question or just a hello. I reply as much as my evenings allow.</p>
  <dl class="kv">
    <dt>Email</dt><dd><a href="mailto:hello@pockio.eu">[YOUR EMAIL]</a></dd>
    <dt>Google Play</dt><dd><a href="https://play.google.com/">[LINK TO DEVELOPER ACCOUNT]</a></dd>
  </dl>
  <p class="mut">Reporting a bug? Include the app name, its version and your phone model.</p>
</TerminalPage>
